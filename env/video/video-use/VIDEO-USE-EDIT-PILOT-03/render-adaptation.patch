@@ -34,8 +35,53 @@
 # -------- Frame extraction ---------------------------------------------------
 
 
+def effective_time_range(video: Path, start: float, end: float) -> tuple[float, float]:
+    """Clamp a requested view to actual frame timestamps in the media.
+
+    ffmpeg commonly exits non-zero when asked for a still at exactly the
+    container duration. Keep the last request at least one source frame before
+    the probed duration, while retaining the caller's range whenever valid.
+    """
+    if not (float("-inf") < start < float("inf") and float("-inf") < end < float("inf")):
+        raise ValueError("timeline range must be finite")
+    if end <= start:
+        raise ValueError("timeline end must be greater than start")
+    probe = subprocess.run(
+        ["ffprobe", "-v", "error", "-select_streams", "v:0",
+         "-show_entries", "format=duration:stream=avg_frame_rate,r_frame_rate",
+         "-of", "json", str(video)],
+        capture_output=True, text=True, check=True,
+    )
+    info = json.loads(probe.stdout)
+    streams = info.get("streams") or []
+    duration = float((info.get("format") or {})["duration"])
+    fps = None
+    if streams:
+        for key in ("avg_frame_rate", "r_frame_rate"):
+            value = streams[0].get(key)
+            try:
+                rate = float(Fraction(value)) if value and value != "0/0" else 0.0
+            except (ValueError, ZeroDivisionError):
+                rate = 0.0
+            if rate > 0:
+                fps = rate
+                break
+    if duration <= 0 or fps is None:
+        raise ValueError("cannot determine a valid video duration and frame rate")
+    # Seeking at the nominal last frame can still land after the final decoded
+    # packet when AAC/video durations differ or the container rounds duration.
+    # Stay two frame periods inside the probed duration for a valid still.
+    last_frame_time = max(0.0, duration - 2.0 / fps - 0.001)
+    start = max(0.0, min(start, last_frame_time))
+    end = max(0.0, min(end, last_frame_time))
+    if end <= start:
+        raise ValueError("timeline range contains no valid frame timestamps")
+    return start, end
+
+
 def extract_frames(video: Path, start: float, end: float, n: int, dest_dir: Path) -> list[Path]:
     """Extract N frames evenly spaced across [start, end]. Returns paths in order."""
+    start, end = effective_time_range(video, start, end)
     dest_dir.mkdir(parents=True, exist_ok=True)
     if n < 1:
