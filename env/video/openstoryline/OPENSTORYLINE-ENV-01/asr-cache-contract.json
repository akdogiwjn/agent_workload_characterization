{
  "schema": "openstoryline-asr-cache-contract-v1",
  "host_cache_root_relative": "env/video/openstoryline/OPENSTORYLINE-ENV-01/models",
  "container_cache_mount": "/root/.cache/modelscope",
  "container_model_root": "/root/.cache/modelscope/models",
  "model_dirs": {
    "asr": "iic--speech_paraformer-large-vad-punc_asr_nat-en-16k-common-vocab10020/snapshots/master",
    "vad": "iic--speech_fsmn_vad_zh-cn-16k-common-pytorch/snapshots/master",
    "punc": "iic--punc_ct-transformer_cn-en-common-vocab471067-large/snapshots/master"
  },
  "required_files": {
    "asr": ["configuration.json", "config.yaml", "model.pt", "tokens.json", "bpe.model", "am.mvn"],
    "vad": ["configuration.json", "config.yaml", "model.pt", "am.mvn"],
    "punc": ["configuration.json", "config.yaml", "model.pt", "tokens.json", "jieba.c.dict", "jieba_usr_dict"]
  },
  "offline_environment": {
    "MODELSCOPE_CACHE": "/root/.cache/modelscope",
    "MODELSCOPE_OFFLINE": "1",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1"
  }
}
