+    identity = request.get("frozen_identity")
+    if not isinstance(identity, dict) or identity.get("budget") != normalized:
+        raise ValueError("request budget must exactly match the new frozen identity budget")
+    declared_sha = identity.get("identity_sha256")
+    identity_payload = {key: value for key, value in identity.items() if key != "identity_sha256"}
+    canonical = json.dumps(identity_payload, sort_keys=True, separators=(",", ":"),
+                           ensure_ascii=False).encode("utf-8")
+    actual_sha = hashlib.sha256(canonical).hexdigest()
+    if declared_sha != actual_sha:
+        raise ValueError("frozen identity SHA-256 does not match its contents")
