+"""Lightweight, offline ASR cache checks run before any model is instantiated."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+
+def validate_asr_cache(*, model_root: str | Path | None = None,
+                       contract_path: str | Path | None = None) -> list[dict]:
+    contract_file = Path(contract_path or os.getenv(
+        "OPENSTORYLINE_ASR_CONTRACT_PATH", "/opt/openstoryline/asr-cache-contract.json"))
+    try:
+        spec = json.loads(contract_file.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise RuntimeError(f"OpenStoryline ASR cache contract is unavailable: {contract_file}: {exc}") from exc
+
+    root = Path(model_root or os.getenv(
+        "OPENSTORYLINE_ASR_MODEL_ROOT", spec["container_model_root"])).resolve()
+    records = []
+    errors = []
+    for model, rel_dir in spec["model_dirs"].items():
+        model_dir = (root / rel_dir).resolve()
+        try:
+            model_dir.relative_to(root)
+        except ValueError:
+            errors.append(f"{model}: configured directory escapes model root: {model_dir}")
+            continue
+        for filename in spec["required_files"][model]:
+            path = model_dir / filename
+            try:
+                with path.open("rb") as stream:
+                    stat = os.fstat(stream.fileno())
+                if not path.is_file() or stat.st_size <= 0:
+                    raise OSError("not a nonempty regular file")
+                records.append({"model": model, "path": str(path), "bytes": stat.st_size, "readable": True})
+            except OSError as exc:
+                errors.append(f"{model}: required local ASR asset unreadable or missing: {path}: {exc}")
+    if errors:
+        raise RuntimeError("ASR cache preflight failed before model initialization: " + " | ".join(errors))
+    return records
