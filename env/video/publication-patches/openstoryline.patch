+                                    "message_count": len(messages),
+                                    "confirmations_sent": confirmation_count,
+                                    "scope_check": scope_reason,
+                                    "plan_text": _json_safe(plan_text, secret)}
+                    (output / "agent-result.json").write_text(
+                        json.dumps(final_status, ensure_ascii=False, indent=2) + "\n",
+                        encoding="utf-8")
+                    return 0
+                confirmation_count += 1
+                _save_session_status(
+                    output, "executing", session_id=session_id,
+                    approval_source="user_pre_authorization_in_request",
+                    confirmation_message_index=len(messages),
+                    confirmations_sent=confirmation_count,
+                    scope_check=scope_reason,
+                )
+                confirmation = HumanMessage(content=(
+                    "我已在本次任务中预先授权刚才这份范围内剪辑计划。请按该计划继续执行。"
+                    "这条确认来自本次用户预授权，不代表用户曾现场点击界面确认。"
+                ))
+                payload = {"messages": continue_with_confirmation(messages, confirmation)}
+                continue
+
+            # A conversational stop is not a completed editing task. Require
+            # all native artifacts and successful MCP results before returning
+            # an execution-complete state to the host exporter.
+            required_nodes = {"load_media", "split_shots", "local_asr",
+                              "speech_rough_cut", "plan_timeline_pro", "render_video"}
+            latest = {node: store.get_latest_meta(node_id=node, session_id=session_id)
+                      for node in required_nodes}
+            events_file = output / "mcp-tool-events.jsonl"
+            events = []
+            if events_file.is_file():
+                events = [json.loads(line) for line in events_file.read_text(
+                    encoding="utf-8").splitlines() if line.strip()]
+            successful_nodes = {
+                row.get("node_id") for row in events
+                if row.get("event") == "tool_call_finished" and not row.get("is_error")
+            }
+            complete, missing = complete_native_chain(
+                {node for node, meta in latest.items() if meta is not None},
+                successful_nodes,
+            )
+            if not complete:
+                status = ("budget_exhausted" if
+                          os.environ.get("OPENSTORYLINE_BUDGET_EXHAUSTED") == "1"
+                          else "failed")
+                reason = "logical request or observed usage budget exhausted" if status == "budget_exhausted" else "Agent returned without the complete native render chain"
+                _save_session_status(output, status, session_id=session_id,
+                                     missing_nodes=missing, reason=reason,
+                                     confirmations_sent=confirmation_count)
+                (output / "agent-result.json").write_text(
+                    json.dumps({"status": status, "reason": reason,
+                                "missing_nodes": missing,
+                                "message_count": len(messages)}, indent=2) + "\n",
+                    encoding="utf-8")
+                return 2 if status == "failed" else 3
+            _save_session_status(output, "executing", session_id=session_id,
+                                 approval_source="user_pre_authorization_in_request",
+                                 confirmations_sent=confirmation_count,
+                                 render_artifact_id=latest["render_video"].artifact_id)
+            (output / "agent-result.json").write_text(
+                json.dumps({"status": "executing", "message_count": len(messages),
+                            "confirmations_sent": confirmation_count,
+                            "render_artifact_id": latest["render_video"].artifact_id,
+                            "submission_export_pending": True}, indent=2) + "\n",
+                encoding="utf-8")
+            break
+        phase["agent_finished_monotonic_ns"] = time.monotonic_ns()
+        return 0
+    except Exception as exc:
+        phase["failure_monotonic_ns"] = time.monotonic_ns()
+        phase["failure_type"] = type(exc).__name__
+        phase["failure"] = _json_safe(str(exc), secret)
+        failed_status = ("budget_exhausted" if
+                         os.environ.get("OPENSTORYLINE_BUDGET_EXHAUSTED") == "1"
+                         else "failed")
+        _save_session_status(output, failed_status, session_id=session_id,
+                             failure_type=type(exc).__name__,
+                             reason=_json_safe(str(exc), secret))
+        (output / "agent-result.json").write_text(
+            json.dumps({"status": failed_status, "error_type": type(exc).__name__,
+                        "error": _json_safe(str(exc), secret)}, indent=2) + "\n",
+            encoding="utf-8")
+        return 1
+    finally:
+        if mcp.poll() is None:
+            try:
+                os.killpg(mcp.pid, signal.SIGTERM)
+                mcp.wait(timeout=10)
+            except Exception:
+                try:
+                    os.killpg(mcp.pid, signal.SIGKILL)
+                    mcp.wait(timeout=5)
+                except Exception:
+                    pass
+        phase["mcp_exit_returncode"] = mcp.poll()
+        phase["mcp_cleanup_status"] = "stopped" if mcp.poll() is not None else "still_running"
+        server_log.flush()
+        server_log.close()
+        if fake_model:
+            fake_model.close()
+        (output / "mcp-cleanup.json").write_text(
+            json.dumps({"returncode": mcp.returncode, "pid_alive": mcp.poll() is None}, indent=2) + "\n",
+            encoding="utf-8")
+        (output / "phase-times.json").write_text(
+            json.dumps(phase, indent=2) + "\n", encoding="utf-8")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--request", type=Path, default=Path("/workspace/request.json"))
+    args = parser.parse_args()
+    try:
+        return asyncio.run(run_request(args.request))
+    except Exception as exc:
+        try:
+            request = json.loads(args.request.read_text(encoding="utf-8"))
+            output = Path(request["output_dir"]).resolve()
+            output.mkdir(parents=True, exist_ok=True)
+            secret = os.environ.get(API_KEY_ENV, "")
+            record = {"status": "entry_error", "error_type": type(exc).__name__,
+                      "error": _json_safe(str(exc), secret),
+                      "observed_monotonic_ns": time.monotonic_ns()}
+            with (output / "entry-error.json").open("x", encoding="utf-8") as stream:
+                json.dump(record, stream, ensure_ascii=False, indent=2)
+                stream.write("\n")
+                stream.flush()
+                os.fsync(stream.fileno())
+        except Exception:
+            pass
+        return 1
+
+
