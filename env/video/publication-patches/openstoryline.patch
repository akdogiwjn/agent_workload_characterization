+        "schema": "openstoryline-run-budget-v1",
+        "identity_sha256": actual_sha,
+        "max_logical_requests": normalized["max_logical_requests"],
+        "max_observed_tokens_soft_threshold": normalized["max_observed_tokens_soft_threshold"],
+        "max_output_tokens_per_request": normalized["max_output_tokens_per_request"],
+        "observed_token_semantics": "post-response soft threshold; an in-flight response can cross it",
+        "ledger_path": str(ledger),
+    }
+    with budget_record.open("x", encoding="utf-8") as stream:
+        json.dump(record, stream, ensure_ascii=False, indent=2)
+        stream.write("\n")
+        stream.flush()
+        os.fsync(stream.fileno())
+    return record
