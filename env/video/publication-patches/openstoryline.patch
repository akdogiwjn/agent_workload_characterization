+"""Small per-run model request ledger and conservative request budget gate."""
+from __future__ import annotations
+
+import json
+import os
+import re
+import time
+import uuid
+from contextlib import contextmanager
+from contextvars import ContextVar
+from pathlib import Path
+from typing import Any
+
+from langchain_core.callbacks import BaseCallbackHandler
+
+_MANUAL_REQUEST_ACTIVE: ContextVar[bool] = ContextVar(
+    "openstoryline_manual_request_active", default=False)
+
+
+@contextmanager
+def manual_request_scope():
+    """Keep callback propagation from double-recording a manually gated call."""
+    token = _MANUAL_REQUEST_ACTIVE.set(True)
+    try:
+        yield
+    finally:
+        _MANUAL_REQUEST_ACTIVE.reset(token)
+
+
+def _path() -> Path | None:
+    root = os.getenv("OPENSTORYLINE_TRACE_DIR")
+    return Path(root) / "model-requests.jsonl" if root else None
+
+
+def _events(path: Path) -> list[dict[str, Any]]:
+    if not path.exists():
+        return []
+    out = []
+    for line in path.read_text(encoding="utf-8").splitlines():
+        try:
+            out.append(json.loads(line))
+        except json.JSONDecodeError:
+            continue
+    return out
+
+
+def observed_tokens() -> int:
+    path = _path()
+    total = 0
+    if path:
+        for event in _events(path):
+            if event.get("event") != "request_finished" or not isinstance(event.get("usage"), dict):
+                continue
+            usage = event["usage"]
+            total += int(usage.get("total_tokens", usage.get("input_tokens", 0) +
+                                   usage.get("output_tokens", 0)) or 0)
+    return total
+
+
+def _positive_int(name: str, default: int) -> int:
+    value = int(os.getenv(name, str(default)))
+    if value <= 0:
+        raise ValueError(f"{name} must be a positive integer")
+    return value
+
+
+def max_logical_requests() -> int:
+    return _positive_int("OPENSTORYLINE_MAX_LOGICAL_REQUESTS", 60)
+
+
+def max_observed_tokens_soft_threshold() -> int:
+    return _positive_int("OPENSTORYLINE_MAX_OBSERVED_TOKENS_SOFT_THRESHOLD", 1_000_000)
+
+
+def max_output_tokens_per_request() -> int:
+    return _positive_int("OPENSTORYLINE_MAX_OUTPUT_TOKENS_PER_REQUEST", 32768)
+
+
+def begin_request(*, phase: str, model: str, modality: str = "text",
+                  output_token_limit: int | None = None,
+                  association: dict[str, Any] | None = None) -> dict[str, Any]:
+    """Gate request count and prior observed usage before network I/O.
+
+    The observed-usage threshold blocks subsequent requests after usage is
+    returned. A response already in flight may cross it; it is not an absolute
+    cumulative token ceiling. The separate output limit is sent to the model.
+    """
+    path = _path()
+    count = sum(1 for e in _events(path) if e.get("event") == "request_started") if path else 0
+    limit = max_logical_requests()
+    token_threshold = max_observed_tokens_soft_threshold()
+    output_limit = output_token_limit or max_output_tokens_per_request()
+    if output_limit <= 0 or output_limit > max_output_tokens_per_request():
+        raise ValueError("request output-token limit must be within the configured per-request cap")
+    attempt = {"request_id": uuid.uuid4().hex, "phase": phase, "model": model,
+               "modality": modality, "started_monotonic_ns": time.monotonic_ns(),
+               "max_output_tokens_per_request": output_limit}
+    if association:
+        attempt["association"] = _safe_metadata(association)
+    if (os.getenv("OPENSTORYLINE_BUDGET_EXHAUSTED") == "1" or count >= limit
+            or observed_tokens() >= token_threshold):
+        reason = (f"logical request cap {limit} reached" if count >= limit else
+                  f"prior observed-usage soft threshold {token_threshold} reached")
+        finish_request(attempt, status="blocked_budget", error=reason)
+        raise RuntimeError(f"logical model request budget exhausted: {reason}")
+    _append({"event": "request_started", **attempt})
+    return attempt
+
+
+def finish_request(attempt: dict[str, Any], *, status: str,
+                   usage: Any = None, response_metadata: Any = None,
+                   error: str | None = None) -> None:
+    safe_error = error or ""
+    safe_error = re.sub(r"(?i)bearer\s+[^\s,;]+", "Bearer [REDACTED]", safe_error)
+    secret = os.getenv("DASHSCOPE_API_KEY", "")
+    if secret:
+        safe_error = safe_error.replace(secret, "[REDACTED]")
+    usage = _safe_metadata(usage)
+    response_metadata = _safe_metadata(response_metadata)
+    _append({"event": "request_finished", "request_id": attempt["request_id"],
+             "phase": attempt["phase"], "model": attempt["model"],
+             "modality": attempt["modality"], "status": status,
+             "finished_monotonic_ns": time.monotonic_ns(),
+             "association": attempt.get("association"),
+             "usage": usage, "response_metadata": response_metadata,
+             "error": safe_error or None})
+    path = _path()
+    if path:
+        events = _events(path)
+        total = observed_tokens()
+        request_limit = max_logical_requests()
+        token_threshold = max_observed_tokens_soft_threshold()
+        _append({"event": "budget_snapshot", "observed_total_tokens": total,
+                 "max_observed_tokens_soft_threshold": token_threshold,
+                 "observed_usage_threshold_reached": total >= token_threshold,
+                 "max_logical_requests": request_limit,
+                 "logical_requests": sum(1 for e in events if e.get("event") == "request_started"),
+                 "max_output_tokens_per_request": max_output_tokens_per_request()})
+        if total >= token_threshold:
+            os.environ["OPENSTORYLINE_BUDGET_EXHAUSTED"] = "1"
+
+
+def _safe_metadata(value: Any) -> Any:
+    if isinstance(value, dict):
+        return {str(k): _safe_metadata(v) for k, v in value.items()
+                if str(k).lower() not in {"api_key", "authorization", "headers", "credential"}}
+    if isinstance(value, (list, tuple)):
+        return [_safe_metadata(v) for v in value]
+    if isinstance(value, (str, int, float, bool)) or value is None:
+        secret = os.getenv("DASHSCOPE_API_KEY", "")
+        return value.replace(secret, "[REDACTED]") if secret and isinstance(value, str) else value
+    return str(value)
+
+
+def _append(event: dict[str, Any]) -> None:
+    path = _path()
+    if path is None:
+        return
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("a", encoding="utf-8") as stream:
+        stream.write(json.dumps(event, ensure_ascii=False, default=str) + "\n")
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+class RequestRecorder(BaseCallbackHandler):
+    """LangChain callback that records each model invocation and returned usage."""
+    raise_error = True
+
+    def __init__(self, phase: str):
+        self.phase = phase
+        self.pending: dict[str, dict[str, Any]] = {}
+
+    def on_chat_model_start(self, serialized: dict[str, Any], messages: list[list[Any]],
+                            run_id: Any, **kwargs: Any) -> None:
+        if _MANUAL_REQUEST_ACTIVE.get():
+            return
+        model = str((serialized or {}).get("kwargs", {}).get("model") or
+                    (serialized or {}).get("kwargs", {}).get("model_name") or "unknown")
+        self.pending[str(run_id)] = begin_request(phase=self.phase, model=model)
+
+    def on_llm_end(self, response: Any, run_id: Any, **kwargs: Any) -> None:
+        attempt = self.pending.pop(str(run_id), None)
+        if attempt is None:
+            return
+        message = None
+        try:
+            message = response.generations[0][0].message
+        except (AttributeError, IndexError, TypeError):
+            pass
+        llm_output = getattr(response, "llm_output", None) or {}
+        usage = getattr(message, "usage_metadata", None) or llm_output.get("token_usage")
+        metadata = getattr(message, "response_metadata", None)
+        if message is not None:
+            calls = getattr(message, "tool_calls", None) or []
+            if calls:
+                attempt["association"] = {"tool_call_ids": [
+                    str(call.get("id")) for call in calls if call.get("id")
+                ]}
+        finish_request(attempt, status="completed", usage=usage, response_metadata=metadata)
+
+    def on_llm_error(self, error: BaseException, run_id: Any, **kwargs: Any) -> None:
+        attempt = self.pending.pop(str(run_id), None)
+        if attempt is not None:
+            finish_request(attempt, status="error", error=f"{type(error).__name__}: {error}")
+
