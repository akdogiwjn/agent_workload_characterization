+"""Project-side ASR adapter for the English paraformer checkpoint.
+
+Works around two funasr 1.3.1 wiring bugs for
+iic/speech_paraformer-large-vad-punc_asr_nat-en-16k-common-vocab10020:
+  1. SentencepiecesTokenizer decodes with a mismatched 10000-piece bpe.model
+     while the decoder outputs ids in the 10020-entry tokens.json space;
+  2. word timestamps never reach the result (auto_model does not pass
+     pred_timestamp; the BPE branch of model.py has an UnboundLocalError).
+
+No global monkey patching: the adapter is injected explicitly into
+LocalASRNode by the task entry wiring in mcp/register_tools.py. The adapter
+class is imported lazily so the lightweight cache preflight can run first.
+"""
+
+def __getattr__(name):
+    if name == "ParaformerEnAsr":
+        from .paraformer_en import ParaformerEnAsr
+        return ParaformerEnAsr
+    raise AttributeError(name)
