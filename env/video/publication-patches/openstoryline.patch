+    budget = request.get("budget")
+    if not isinstance(budget, dict):
+        raise ValueError("request must contain an explicit budget object")
+    required = {"max_logical_requests", "max_observed_tokens_soft_threshold",
+                "max_output_tokens_per_request"}
+    missing = required - set(budget)
+    if missing:
+        raise ValueError(f"new budget identity is missing fields: {sorted(missing)}")
+    normalized = {key: int(budget[key]) for key in required}
+    if any(value <= 0 for value in normalized.values()):
+        raise ValueError("all budget values must be positive integers")
+    ceilings = {
+        "max_logical_requests": FROZEN_MAX_REQUESTS,
+        "max_observed_tokens_soft_threshold": FROZEN_MAX_OBSERVED_TOKENS_SOFT_THRESHOLD,
+        "max_output_tokens_per_request": FROZEN_MAX_OUTPUT_TOKENS_PER_REQUEST,
+    }
+    for key, value in normalized.items():
+        if value > ceilings[key]:
+            raise ValueError(f"{key} exceeds the frozen ceiling {ceilings[key]}")
