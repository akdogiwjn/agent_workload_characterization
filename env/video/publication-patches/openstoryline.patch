+"""Narrow, auditable plan-confirmation classifier for the native agent entry."""
+from __future__ import annotations
+
+import re
+from typing import Any
+
+
+REQUIRED_STEPS = {
+    "load_media", "split_shots", "local_asr", "speech_rough_cut",
+    "plan_timeline_pro", "render_video",
+}
+STEP_ALIASES = {
+    "load_media": ("加载媒体",),
+    "split_shots": ("镜头切分",),
+    "local_asr": ("本地asr", "本地语音识别"),
+    "speech_rough_cut": ("语音粗剪",),
+    "plan_timeline_pro": ("规划时间线", "时间线规划"),
+    "render_video": ("渲染视频",),
+}
+ALLOWED_BACKTICK_NAMES = REQUIRED_STEPS | {
+    "mode", "gap_threshold", "is_speech_rough_cut", "include_video_audio",
+    "video_volume_scale", "output.mp4", "cuts.json",
+}
+OUT_OF_SCOPE_ACTION = re.compile(
+    r"(?:添加|加入|增加|加|使用)\s*(字幕|音乐|配乐|动画|调色|转场|外部素材)|"
+    r"(?:add|include|use)\s+(subtitles?|music|animation|color grading|transitions?|external assets?)",
+    re.IGNORECASE,
+)
+NEGATION = ("不要", "不添加", "不加入", "不增加", "不使用", "不", "禁止", "避免", "do not", "don't", "without")
+CONFIRMATION_ASK = re.compile(
+    r"(请.{0,12}确认.{0,12}(计划|方案)|确认.{0,12}(计划|方案).{0,12}(后|吗|？|\?)|"
+    r"please\s+confirm.{0,30}plan|confirm.{0,30}plan.{0,15}\?)",
+    re.IGNORECASE | re.DOTALL,
+)
+CLARIFICATION_CUE = re.compile(
+    r"(请问|你希望|您希望|需要你提供|请补充|还需要你|which\s+|what\s+|"
+    r"could you clarify|please specify|what duration|which range)",
+    re.IGNORECASE,
+)
+
+
+def _get(message: Any, key: str, default: Any = None) -> Any:
+    if isinstance(message, dict):
+        return message.get(key, default)
+    return getattr(message, key, default)
+
+
+def _kind(message: Any) -> str:
+    value = _get(message, "type") or _get(message, "role") or ""
+    return str(value).lower()
+
+
+def _content(message: Any) -> str:
+    value = _get(message, "content", "")
+    return value if isinstance(value, str) else str(value)
+
+
+def confirmation_request(messages: list[Any]) -> tuple[bool, str]:
+    """Return (awaiting, assistant plan text); never approves generic questions."""
+    assistants = [m for m in messages if _kind(m) in {"ai", "assistant"}]
+    if not assistants:
+        return False, ""
+    last = _content(assistants[-1])
+    if not CONFIRMATION_ASK.search(last):
+        return False, last
+    return True, last
+
+
+def plan_is_preapproved(messages: list[Any]) -> tuple[bool, str]:
+    """Accept only the named native workflow and explicitly preserved media contract."""
+    awaiting, plan = confirmation_request(messages)
+    if not awaiting:
+        return False, "latest assistant message is not a plan-confirmation request"
+    if CLARIFICATION_CUE.search(plan):
+        return False, "plan also contains an unrelated clarification request"
+    folded = plan.lower()
+    missing = sorted(step for step in REQUIRED_STEPS
+                     if step not in folded and not any(alias.lower() in folded
+                                                       for alias in STEP_ALIASES[step]))
+    if missing:
+        return False, f"plan omits required native step(s): {', '.join(missing)}"
+
+    # Backticked identifiers are an explicit list of tools/options in the plan.
+    names = set(re.findall(r"`([^`]+)`", plan))
+    unexpected = []
+    for name in names:
+        head = name.split("(", 1)[0].strip()
+        if head in REQUIRED_STEPS or name in ALLOWED_BACKTICK_NAMES:
+            continue
+        if re.fullmatch(r"(?:mode=skip|gap_threshold=0|is_speech_rough_cut=true|"
+                        r"include_video_audio=true|video_volume_scale=1(?:\.0)?)", name):
+            continue
+        unexpected.append(name)
+    unexpected.sort()
+    if unexpected:
+        return False, f"plan contains an unapproved tool/option: {unexpected[0]}"
+
+    lower = plan.lower()
+    for match in OUT_OF_SCOPE_ACTION.finditer(plan):
+        prefix = lower[max(0, match.start() - 12):match.start()]
+        if not any(word in prefix for word in NEGATION):
+            return False, f"plan adds out-of-scope material/effect: {match.group(1)}"
+
+    contract_terms = ("原声", "分辨率", "帧率")
+    if not all(term in plan for term in contract_terms):
+        return False, "plan does not explicitly preserve source audio, dimensions, and frame rate"
+    return True, "plan contains only the preauthorized native workflow and output contract"
+
+
+def confirmation_decision(messages: list[Any], confirmations_sent: int,
+                          confirmation_limit: int) -> tuple[str, bool, str]:
+    awaiting, _plan = confirmation_request(messages)
+    if not awaiting:
+        return "executing", False, "no plan confirmation request remains"
+    allowed, reason = plan_is_preapproved(messages)
+    if not allowed:
+        return "awaiting_confirmation", False, reason
+    if confirmations_sent >= confirmation_limit:
+        return "awaiting_confirmation", False, "preauthorized confirmation limit reached"
+    return "executing", True, reason
+
+
+def continue_with_confirmation(messages: list[Any], confirmation: Any) -> list[Any]:
+    """Retain the full transcript, appending only the explicit authorized reply."""
+    return [*messages, confirmation]
+
+
+def complete_native_chain(node_ids: set[str], successful_node_ids: set[str]) -> tuple[bool, list[str]]:
+    missing = sorted(node for node in REQUIRED_STEPS
+                     if node not in node_ids or node not in successful_node_ids)
+    return not missing, missing
