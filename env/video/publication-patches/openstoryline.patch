+"""Local OpenAI-compatible model boundary for offline production-entry checks.
+
+This module is inert unless the task entry receives an explicit offline test
+request and the container has OPENSTORYLINE_ENABLE_OFFLINE_FAKE_MODEL=1.
+It never reads credentials and accepts connections only on container loopback.
+"""
+from __future__ import annotations
+
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import ast
+import json
+import re
+import threading
+import time
+import uuid
+from pathlib import Path
+from typing import Any
+
+
+TOOL_SEQUENCE = (
+    ("load_media", {}),
+    ("split_shots", {"mode": "skip"}),
+    ("local_asr", {}),
+    ("speech_rough_cut", {}),
+    ("plan_timeline_pro", {}),
+    ("render_video", {"include_video_audio": True, "video_volume_scale": 1.0,
+                      "output_max_dimension_px": 320}),
+)
+
+
+class OfflineFakeModel:
+    def __init__(self, output_dir: Path, tool_prefix: str, start_at: str = "load_media"):
+        self.output_dir = output_dir
+        self.tool_prefix = tool_prefix
+        target_names = [target for target, _args in TOOL_SEQUENCE]
+        if start_at not in target_names:
+            raise ValueError(f"offline fake-model start node is not registered: {start_at!r}")
+        self.start_index = target_names.index(start_at)
+        self.records_path = output_dir / "fake-model-requests.jsonl"
+        owner = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def log_message(self, _format, *_args):
+                return
+
+            def do_POST(self):  # noqa: N802
+                if self.path != "/v1/chat/completions":
+                    self.send_error(404)
+                    return
+                try:
+                    length = int(self.headers.get("Content-Length", "0"))
+                    request = json.loads(self.rfile.read(length))
+                    response, action = owner.respond(request)
+                    owner.record(request, action, response)
+                    if request.get("stream"):
+                        chunks = owner.stream_chunks(response)
+                        body = ("".join("data: " + json.dumps(chunk, ensure_ascii=False) + "\n\n"
+                                        for chunk in chunks) + "data: [DONE]\n\n").encode("utf-8")
+                        content_type = "text/event-stream"
+                    else:
+                        body = json.dumps(response, ensure_ascii=False).encode("utf-8")
+                        content_type = "application/json"
+                    self.send_response(200)
+                    self.send_header("Content-Type", content_type)
+                    self.send_header("Content-Length", str(len(body)))
+                    self.end_headers()
+                    self.wfile.write(body)
+                except Exception as exc:  # keep the cause visible to the caller
+                    owner.record({}, "fake_boundary_error", {"error": f"{type(exc).__name__}: {exc}"})
+                    self.send_error(500, f"offline fake model failed: {type(exc).__name__}: {exc}")
+
+        self.server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.server.daemon_threads = True
+        self.thread = threading.Thread(target=self.server.serve_forever,
+                                       name="offline-fake-model", daemon=True)
+        self.base_url = f"http://127.0.0.1:{self.server.server_port}/v1"
+
+    def start(self) -> None:
+        self.thread.start()
+
+    def close(self) -> None:
+        self.server.shutdown()
+        self.server.server_close()
+        self.thread.join(timeout=5)
+
+    def _tool_name(self, target: str, request: dict[str, Any]) -> str:
+        names = set()
+        for tool in request.get("tools") or []:
+            function = tool.get("function") or {}
+            name = function.get("name")
+            if name:
+                names.add(str(name))
+        for candidate in (f"{self.tool_prefix}_{target}", target):
+            if candidate in names:
+                return candidate
+        raise RuntimeError(f"registered MCP tool not found by exact name: {target!r}")
+
+    def _next_tool_call(self, request: dict[str, Any]) -> tuple[dict[str, Any] | None, str]:
+        used = set()
+        queried_artifacts = set()
+        for message in request.get("messages") or []:
+            if message.get("role") != "assistant":
+                continue
+            for call in message.get("tool_calls") or []:
+                function = call.get("function") or {}
