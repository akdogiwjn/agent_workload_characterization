+"""English paraformer ASR with correct vocab wiring and word timestamps.
+
+Works around two funasr 1.3.1 wiring bugs for
+iic/speech_paraformer-large-vad-punc_asr_nat-en-16k-common-vocab10020:
+  1. SentencepiecesTokenizer decodes with a mismatched 10000-piece bpe.model
+     while the decoder outputs ids in the 10020-entry tokens.json space;
+  2. word timestamps never reach the result (auto_model does not pass
+     pred_timestamp; the BPE branch of model.py has an UnboundLocalError).
+
+The word-timestamp computation replicates the fire-place logic of
+funasr.utils.timestamp_tools.ts_prediction_lfr6_standard (1.3.1) WITHOUT
+its optional "<sil>" insertion, so every token gets exactly one
+[start_ms, end_ms] pair; any count mismatch is a hard error.
+"""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from typing import Any, List
+
+import numpy as np
+import torch
+
+_MODEL_ROOT = Path(os.environ.get(
+    "OPENSTORYLINE_ASR_MODEL_ROOT",
+    "/root/.cache/modelscope/models"))
+_DEFAULTS = {
+    "asr": _MODEL_ROOT / "iic--speech_paraformer-large-vad-punc_asr_nat-en-16k-common-vocab10020/snapshots/master",
+    "vad": _MODEL_ROOT / "iic--speech_fsmn_vad_zh-cn-16k-common-pytorch/snapshots/master",
+    "punc": _MODEL_ROOT / "iic--punc_ct-transformer_cn-en-common-vocab471067-large/snapshots/master",
+}
+_SOS, _EOS, _BLANK = 1, 2, 0
+_TIME_RATE_S = 10.0 * 6 / 1000 / 1  # LFR6 frame step (60 ms)
+_FORCE_TIME_SHIFT = -1.5
+
+
+class AsrWiringError(RuntimeError):
+    """Raised when the checkpoint or alignment does not match expectations."""
+
+
+def _fire_place_word_timestamps(alphas: torch.Tensor, peaks: torch.Tensor,
+                                n_tokens: int, vad_offset_ms: float) -> List[list]:
+    """One [start_ms, end_ms] per token; no <sil>; hard error on mismatch.
+
+    Replicates ts_prediction_lfr6_standard (funasr 1.3.1) fire-place logic:
+    token i spans [fire[i], fire[i+1]] in LFR frames; the CIF re-normalize
+    fallback is preserved for peak-count mismatch.
+    """
+    from funasr.utils.timestamp_tools import cif_wo_hidden
+    if len(alphas.shape) == 2:
+        alphas, peaks = alphas[0], peaks[0]
+    fire = (torch.where(peaks >= 1.0 - 1e-4)[0].cpu().numpy()
+            + _FORCE_TIME_SHIFT)
+    if len(fire) != n_tokens + 1:
+        alphas = alphas / alphas.sum() * (n_tokens + 1)
+        peaks = cif_wo_hidden(alphas.unsqueeze(0), threshold=1.0 - 1e-4)[0]
+        fire = (torch.where(peaks >= 1.0 - 1e-4)[0].cpu().numpy()
+                + _FORCE_TIME_SHIFT)
+    if len(fire) < n_tokens + 1:
+        raise AsrWiringError(
+            f"CIF peaks ({len(fire)}) cannot cover {n_tokens} tokens; "
+            "refusing to emit partial timestamps")
+    ts = []
+    for i in range(n_tokens):
+        ts.append([fire[i] * _TIME_RATE_S * 1000 + vad_offset_ms,
+                   fire[i + 1] * _TIME_RATE_S * 1000 + vad_offset_ms])
+    return ts
+
+
+class ParaformerEnAsr:
+    """Drop-in generate() replacement for LocalASRNode's funasr AutoModel."""
+
+    def __init__(self):
+        from funasr import AutoModel
+        self.asr_dir = Path(os.environ.get("OPENSTORYLINE_ASR_DIR", _DEFAULTS["asr"]))
+        self.vad_dir = Path(os.environ.get("OPENSTORYLINE_ASR_VAD_DIR", _DEFAULTS["vad"]))
+        self.punc_dir = Path(os.environ.get("OPENSTORYLINE_ASR_PUNC_DIR", _DEFAULTS["punc"]))
+        self._identity_guard()
+        self.tokens = json.loads((self.asr_dir / "tokens.json").read_text())
+        self._asr = AutoModel(model=str(self.asr_dir), disable_update=True,
+                              disable_pbar=True, disable_log=True)
+        self._vad = AutoModel(model=str(self.vad_dir), disable_update=True,
+                              disable_pbar=True, disable_log=True)
+        self._punc = AutoModel(model=str(self.punc_dir), disable_update=True,
+                               disable_pbar=True, disable_log=True)
+        self._frontend = self._asr.kwargs["frontend"]
+        self._model = self._asr.model
+        embed = None
+        for key, value in self._model.state_dict().items():
+            if "decoder.embed" in key:
+                embed = value.shape[0]
+                break
+        if embed != len(self.tokens):
+            raise AsrWiringError(
+                f"decoder vocab ({embed}) != tokens.json ({len(self.tokens)}); "
+                "refusing to decode with a mismatched table")
+
+    def _identity_guard(self) -> None:
+        cfg = json.loads((self.asr_dir / "configuration.json").read_text())
+        expected = ("iic/speech_paraformer-large-vad-punc_asr_nat-en-16k"
+                    "-common-vocab10020")
+        got = (cfg.get("model_name_in_hub") or {}).get("ms")
+        if got != expected:
+            raise AsrWiringError(f"unexpected checkpoint identity: {got!r}")
+
+    # ------------------------------------------------------------------ #
+    def _forward_segment(self, samples: np.ndarray,
+                         vad_offset_ms: float) -> tuple[List[str], List[list]]:
+        speech = torch.from_numpy(samples.astype(np.float32))[None, :]
+        speech_lens = torch.tensor([speech.shape[1]])
+        with torch.no_grad():
+            feats, feats_lens = self._frontend(speech, speech_lens)
+            enc = self._model.encoder(feats, feats_lens)
+            encoder_out, encoder_out_lens = enc[0], enc[1]
+            po = self._model.calc_predictor(encoder_out, encoder_out_lens)
+            pre_acoustic_embeds, pre_token_length, alphas, pre_peak_index = (
+                po[0], po[1], po[2], po[3])
+            pre_token_length = pre_token_length.round().long()
+            if torch.max(pre_token_length) < 1:
+                return [], []
+            do = self._model.cal_decoder_with_predictor(
+                encoder_out, encoder_out_lens, pre_acoustic_embeds,
+                pre_token_length)
+            decoder_out = do[0]
+        i = 0
+        am_scores = decoder_out[i, : pre_token_length[i], :]
+        yseq = am_scores.argmax(dim=-1).tolist()
+        token_int = [t for t in yseq if t not in (_SOS, _EOS, _BLANK)]
+        pieces = [self.tokens[t] for t in token_int]
+        times = _fire_place_word_timestamps(
+            alphas[i], pre_peak_index[i], len(pieces), vad_offset_ms)
+        if len(times) != len(pieces):
+            raise AsrWiringError("token/timestamp count mismatch")
+        return pieces, times
+
+    def _read_wav(self, path: str) -> tuple[np.ndarray, int]:
+        import wave
+        with wave.open(path, "rb") as w:
+            if w.getframerate() != 16000:
+                raise AsrWiringError(f"expected 16 kHz wav, got {w.getframerate()}")
+            if w.getnchannels() != 1:
+                raise AsrWiringError("expected mono wav")
+            raw = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16)
+        return raw.astype(np.float32) / 32768.0, 16000
+
+    def _vad_segments(self, samples: np.ndarray,
+                      max_single_ms: int) -> List[list]:
+        res = self._vad.generate(
+            input=samples, max_single_segment_time=max_single_ms)
+        value = (res[0] or {}).get("value") if res else None
+        if not value:
+            return [[0, int(len(samples) / 16.0)]]
+        return [[int(s), int(e)] for s, e in value]
+
+    # ------------------------------------------------------------------ #
+    def generate(self, input=None, sentence_timestamp: bool = False,
+                 **kwargs) -> List[dict]:
+        max_single_ms = int((kwargs.get("vad_kwargs") or {}).get(
+            "max_single_segment_time", 30000))
+        samples, sr = self._read_wav(input)
+        duration_ms = len(samples) / (sr / 1000.0)
+        segments = self._vad_segments(samples, max_single_ms)
+
+        all_pieces: List[str] = []
+        all_times: List[list] = []
+        for seg_start_ms, seg_end_ms in segments:
+            a = int(seg_start_ms * sr / 1000.0)
