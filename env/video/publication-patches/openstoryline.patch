+    ledger = output / "model-requests.jsonl"
+    budget_record = output / "budget.json"
+    if ledger.exists() or budget_record.exists():
+        raise RuntimeError("run output already has a budget ledger; refusing to reset or reuse it")
+
+    os.environ["OPENSTORYLINE_MAX_LOGICAL_REQUESTS"] = str(normalized["max_logical_requests"])
+    os.environ["OPENSTORYLINE_MAX_OBSERVED_TOKENS_SOFT_THRESHOLD"] = str(
+        normalized["max_observed_tokens_soft_threshold"])
+    os.environ["OPENSTORYLINE_MAX_OUTPUT_TOKENS_PER_REQUEST"] = str(
+        normalized["max_output_tokens_per_request"])
+    os.environ.pop("OPENSTORYLINE_BUDGET_EXHAUSTED", None)
