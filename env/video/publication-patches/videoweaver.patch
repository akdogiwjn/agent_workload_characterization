+def vision_understanding(media_paths, prompt, model="doubao-seed-2-0-pro-260215", video_fps=1.0):
+    """Bailian image understanding + sampled-frame video review."""
+    if model not in SUPPORTED_MODELS:
+        raise ValueError(f"unsupported vision model '{model}'; Bailian adapter "
+                         f"supports only {sorted(SUPPORTED_MODELS)}")
+    api_key = _api_key()
+    if not api_key:
+        raise ValueError("DASHSCOPE_API_KEY is not set")
+    base_url = _base_url()
+    url = f"{base_url}/chat/completions"
+
+    image_inputs = []
+    mode = "image"
+    for path in media_paths:
+        ext = Path(path).suffix.lower()
+        if ext in IMAGE_EXT:
+            image_inputs.append(_image_to_data_url(path))
+        elif ext in VIDEO_EXT:
+            mode = "sampled_frames"
+            print(f"视频输入检测到：{os.path.basename(path)}；采用抽帧视觉审阅 "
+                  f"mode=sampled_frames（fps={video_fps}，最多{MAX_SAMPLED_FRAMES}帧）。"
+                  "不声称完整观看视频或理解音频；直接视频理解 unsupported。")
+            frames = _sample_video_frames(path, video_fps)
+            image_inputs.extend(url for _, url in frames)
+        else:
+            raise ValueError(f"unsupported media type for vision: {path}")
+
+    if not image_inputs:
+        raise ValueError("no usable media for vision understanding")
+
+    content = [{"type": "text", "text": prompt}]
+    for data_url in image_inputs:
+        content.append({"type": "image_url", "image_url": {"url": data_url}})
+
+    payload = {
+        "model": model,
+        "messages": [{"role": "user", "content": content}],
+    }
+    resp = requests.post(url, headers={
+        "Authorization": f"Bearer {api_key}",
+        "Content-Type": "application/json",
+    }, json=payload, timeout=_HTTP_TIMEOUT)
+    try:
+        body = resp.json()
+    except ValueError:
+        body = {"message": resp.text}
+    if resp.status_code >= 400:
+        raise RuntimeError(f"vision request failed http_{resp.status_code}: {_safe_error(body)}")
+    usage = body.get("usage") or {}
+    choice = (body.get("choices") or [{}])[0]
+    text = (choice.get("message") or {}).get("content") or ""
+    print(f"[Vision mode={mode} usage={usage}]")
+    return text
