+            if not video_url:
+                raise ValueError(f"SUCCEEDED without video_url: {body}")
+            return video_url, body.get("usage")
+        if status in ("FAILED", "CANCELED", "UNKNOWN"):
+            raise RuntimeError(f"video task {task_id} terminal state {status}: "
+                               f"{output.get('code')} {output.get('message')}")
