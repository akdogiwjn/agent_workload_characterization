+def _open_clip_retry(path, retries=4):
+    """Project adaptation: moviepy VideoFileClip can transiently fail to read
+    a just-written clip (ffmpeg reader reads 0 bytes at frame 0). Bounded
+    retry keeps the native merge workflow intact without changing media."""
