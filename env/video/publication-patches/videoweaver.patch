+def _poll_task(task_id, api_key, base_url, interval, window, max_polls):
+    """Poll ONLY this task. Polls carry Authorization. 401/403 abort immediately.
+    A transport error aborts (never re-creates)."""
+    url = f"{base_url}/api/v1/tasks/{task_id}"
+    headers = {"Authorization": f"Bearer {api_key}"}
+    started = time.monotonic()
+    polls = 0
+    while True:
+        elapsed = time.monotonic() - started
+        if elapsed > window:
+            raise RuntimeError(f"video task {task_id} not terminal after {window:g}s "
+                               f"({polls} polls); task may still run remotely and bill")
+        if polls >= max_polls:
+            raise RuntimeError(f"video task {task_id} exceeded {max_polls} polls")
+        if polls:
+            time.sleep(interval)
+        polls += 1
+        try:
+            resp = requests.get(url, headers=headers, timeout=120)
+        except requests.RequestException as exc:
+            raise RuntimeError(f"video poll transport error (aborting, no re-create): {exc}")
+        try:
+            body = resp.json()
+        except ValueError:
+            body = {"message": resp.text}
+        output = body.get("output") or {}
+        status = output.get("task_status")
+        if resp.status_code in (401, 403):
+            raise RuntimeError(f"video poll auth failed http_{resp.status_code}; aborting without retry")
+        if resp.status_code >= 400:
+            raise RuntimeError(f"video poll failed http_{resp.status_code}: {_safe_error(body)}")
+        print(f"Task status: {status}")
+        if status == "SUCCEEDED":
