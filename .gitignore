# 克隆的参考代码仓库（含各自 .git）
references/repos/

# 参考论文 PDF 等二进制大文件
references/papers/*.pdf

# 一般忽略项
__pycache__/
*.py[cod]
*.log
.DS_Store

# 本地 Python 环境、打包和测试缓存
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# data 默认只允许 catalog；原始数据、normalized、缓存及未来数据目录留在本机
/data/*
!/data/catalog/
/data/raw/
/data/normalized/

# 本机凭据；可提交不含密钥的示例
.env
.env.*
!.env.example

.venvs/
data/raw/software/env01/

# 本机可恢复归档：旧文档、整理备份和缓存，不提交 GitHub
/local_archive/

# Docker/OCI 导出、虚拟机及安装镜像；不影响 Docker daemon 中的镜像
*.tar
*.tar.gz
*.tar.zst
*.tgz
*.oci
*.qcow2
*.vmdk
*.vdi
*.vhd
*.vhdx
*.img
*.iso
*.sif

# 冻结的第三方源码副本：保留本机，提交相邻身份清单/版本登记
/env/**/harbor-src/
/env/**/source/

# 大型派生明细与下载对象索引：保留原路径和哈希，GitHub 仅保留摘要/清单
# 不通配忽略所有 JSON/JSONL，以免隐藏配置、测试和小型正式报告
/reports/**/per_trajectory.jsonl
/reports/**/per_template.jsonl
/reports/analysis/OSWORLD-MINIMAX-M3-behavior-v*/summary.json
# OSWorld v4逐command审计明细留本机；摘要、图表及manifest可发布
/reports/analysis/OSWORLD-task-behavior-v4/command_records.jsonl
# SWE-bench补充分析的大型逐对象/实例派生明细保留本机
/reports/analysis/SWEBENCH-COVERAGE-RESULTS-v1/object_links.jsonl
/reports/analysis/SWEBENCH-COVERAGE-RESULTS-v1/per_instance.jsonl
/reports/analysis/SWEBENCH-COVERAGE-RESULTS-v1/negative_coverage_review.jsonl
/reports/analysis/SWEBENCH-COVERAGE-RESULTS-v1/new_behavior_rows.jsonl
/reports/analysis/SWEBENCH-INSTANCE-RESULTS-v1/per_instance.jsonl
/reports/analysis/SWEBENCH-INSTANCE-RESULTS-v1/reviewed_per_instance.jsonl
/reports/analysis/SWE-REBENCH-behavior-v3/reviewed_per_trajectory.jsonl
/reports/analysis/SWE-REBENCH-behavior-v3/protocol_evidence.jsonl
/reports/analysis/SWE-REBENCH-behavior-v3/protocol_detail_evidence.jsonl
/reports/analysis/PUBLIC-TRACE-OPERATIONS-*/coverage.json
/reports/analysis/PUBLIC-TRACE-OPERATIONS-*/summary.json
/reports/analysis/PUBLIC-TRACE-OPERATIONS-*/toolkits.json
/data/catalog/public_trace_acquisition/**/source_metadata/*objects*.jsonl

# catalog 里的下载正文/HTTP记录不是配置；保留相邻manifest、sources和summary
/data/catalog/public_trace_acquisition/**/source_metadata/
/data/catalog/public_trace_acquisition/**/raw/
/data/catalog/public_trace_acquisition/**/http/

# 许可/镜像核查的网页、registry响应留本机，尤其不可提交token响应
/data/catalog/p1_12_closure_evidence/*
!/data/catalog/p1_12_closure_evidence/manifest.json
!/data/catalog/p1_12_closure_evidence/license_*

# 新采样批次的逐点/逐run派生明细保留本机；上传汇总表、SVG和哈希清单
/reports/analysis/LOCAL-THREE-CLASS-*/series/
/reports/analysis/LOCAL-THREE-CLASS-*/per_run.jsonl
/reports/analysis/VOLCANO-THREE-CHAIN-*/series/
/reports/analysis/VOLCANO-THREE-CHAIN-*/per_run.jsonl

# 历史错路由Office报告含认证拒绝细节；原件只留本机，不改写证据
/reports/resource/LOCAL-THREE-CLASS-REPEAT-01-CONTINUATION-01/*-office/run-report.json
